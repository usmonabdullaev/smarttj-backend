{
  "name": "smart-nest",
  "version": "0.0.1",
  "description": "E-commerce project",
  "author": {
    "name": "Abdulloev Usmon",
    "email": "abdullaevusmon2006@gmail.com",
    "url": "https://abdulloev-usmon.vercel.app"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:deploy": "npx prisma migrate deploy --schema=./node_modules/@smarttj/core/prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=./node_modules/@smarttj/core/prisma/schema.prisma",
    "prisma:seed": "node dist/database/seeds/index.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "generate:jwt-secret": "node -e \"console.log(require('crypto').randomBytes(16).toString('hex'))\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@smarttj/core": "^1.1.5",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "nest-winston": "^1.10.2",
    "passport-jwt": "^4.0.1",
    "patcode": "^1.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "streamifier": "^0.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "nest-winston": {
      "@nestjs/common": "$@nestjs/common"
    },
    "deepmerge-ts": "^8.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.2": true,
    "argon2@0.45.1": true,
    "prisma@7.10.0": true,
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "unrs-resolver": false
  }
}
